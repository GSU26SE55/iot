<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The setup portal is served by the ESP32 over local HTTP. Navigation is
         restricted to the three portal hosts in MainActivity. -->
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">solargw.local</domain>
        <domain includeSubdomains="false">solar-gateway.local</domain>
    </domain-config>
</network-security-config>
