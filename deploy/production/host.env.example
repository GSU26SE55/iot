# Copy to /opt/solar-iot/config/host.env on the backend + IoT VPS.
IOT_PUBLIC_DOMAIN=mqtt.solars.io.vn
IOT_PUBLIC_IPV4=203.0.113.10
MQTT_BIND_IP=0.0.0.0
MQTT_TLS_PORT=8883
SOLAR_RUNTIME_GID=10001
MQTT_AUTH_DIR=/opt/solar-iot/secrets/mosquitto/auth
MQTT_TLS_DIR=/opt/solar-iot/secrets/mosquitto/tls
MQTT_DATA_DIR=/opt/solar-iot/data/mosquitto/data
MQTT_LOG_DIR=/opt/solar-iot/data/mosquitto/log
