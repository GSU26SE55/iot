{
  "backendBaseUrl": "http://localhost:4001",
  "apiKey": "dev-battery-ingest-key",
  "deviceCode": "GW-RS485-001",
  "ingestMode": "legacy",
  "adapter": "modbus",
  "pollingIntervalSec": 30,
  "heartbeatIntervalSec": 60,
  "batchSize": 20,
  "requestTimeoutSec": 10,
  "clockSkewMaxSec": 300,
  "queueDbPath": "data/gateway_queue.sqlite3",
  "dryRun": true,
  "logLevel": "INFO",
  "model": "RaspberryPi-4B",
  "firmwareVersion": "0.1.0",
  "batteryMappings": [
    {
      "batteryAssetSerial": "BAT-2026-001",
      "batteryAssetId": "00000000-0000-0000-0000-000000000001",
      "sensorSourceCode": "primary"
    }
  ],
  "calibrations": [],
  "hardware": {
    "modbus": {
      "port": "/dev/ttyUSB0",
      "baudrate": 9600,
      "bytesize": 8,
      "parity": "N",
      "stopbits": 1,
      "timeoutSec": 2,
      "unitId": 1,
      "registers": {
        "voltage": { "address": 0, "scale": 0.01 },
        "current": { "address": 1, "scale": 0.01, "signed": true },
        "temperature": { "address": 2, "scale": 0.1, "offset": -40 },
        "socPercent": { "address": 3, "scale": 1 },
        "cycleCount": { "address": 4, "scale": 1 },
        "sohPercent": { "address": 5, "scale": 1 }
      }
    }
  }
}

