{
  "permissions": {
    "allow": [
      "WebSearch",
      "mcp__context7__resolve-library-id",
      "mcp__context7__get-library-docs",
      "Bash(curl:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(chmod:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(dotnet:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(ruff:*)",
      "Bash(uvicorn:*)",
      "Bash(pytest:*)",
      "Bash(jq:*)",
      "WebFetch(domain:docs.phinix.org)",
      "WebFetch(domain:www.bdtronics.com)",
      "WebFetch(domain:www.manualslib.com)",
      "WebFetch(domain:www.gobelpower.com)",
      "WebFetch(domain:www.macsbatteries.com)",
      "WebFetch(domain:www.scribd.com)",
      "WebFetch(domain:onvolt.pl)",
      "WebFetch(domain:www.amazon.com)",
      "WebFetch(domain:jikongbms.com)",
      "WebFetch(domain:jag35.com)",
      "WebFetch(domain:batteri-energi.dk)",
      "WebFetch(domain:www.evlithium.com)",
      "WebFetch(domain:www.thegioiic.com)"
    ]
  },
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/block-dangerous-commands.sh",
            "timeout": 5,
            "statusMessage": "Checking command safety..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle/scan-secrets-precommit.sh",
            "timeout": 10,
            "statusMessage": "Scanning staged diff for secrets..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/protect-sensitive-files.sh",
            "timeout": 5,
            "statusMessage": "Checking file safety..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/post-edit-feedback.sh",
            "timeout": 10,
            "statusMessage": "Checking BE code patterns..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/validate-namespace.sh",
            "timeout": 5,
            "statusMessage": "Validating namespace..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/check-dbcontext-update.sh",
            "timeout": 5,
            "statusMessage": "Checking entity registration..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/check-di-registration.sh",
            "timeout": 5,
            "statusMessage": "Checking DI registration..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/be/check-build.sh",
            "timeout": 60,
            "statusMessage": "Building .NET project..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fe/post-edit-feedback.sh",
            "timeout": 10,
            "statusMessage": "Checking FE code patterns..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fe/check-build.sh",
            "timeout": 60,
            "statusMessage": "TypeScript type check..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai/check-ruff.sh",
            "timeout": 15,
            "statusMessage": "Ruff lint + format check..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ai/check-random-seed.sh",
            "timeout": 5,
            "statusMessage": "Checking random seed in training script..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle/track-edits-suggest-compact.sh",
            "timeout": 5,
            "statusMessage": "Tracking session size..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lifecycle/stop-suggest-lesson.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
