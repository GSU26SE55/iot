[Unit]
Description=Solar Battery IoT Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/solar-battery-iot
Environment=GATEWAY_API_KEY=replace-with-device-api-key
ExecStart=/usr/bin/python3 -m gateway.main --config /etc/solar-battery-gateway/config.json --loop
Restart=always
RestartSec=5
User=solar-gateway
Group=solar-gateway

[Install]
WantedBy=multi-user.target

